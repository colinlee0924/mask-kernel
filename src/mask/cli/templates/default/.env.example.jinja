# LLM Provider API Keys
ANTHROPIC_API_KEY=your-anthropic-key
# OPENAI_API_KEY=your-openai-key
# GOOGLE_API_KEY=your-google-key

# MASK Configuration
MASK_LLM_PROVIDER=anthropic

# Phoenix Observability
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT_NAME={{ project_name }}
# PHOENIX_API_KEY=your-phoenix-api-key

# Langfuse Observability (optional alternative)
# LANGFUSE_SECRET_KEY=your-langfuse-project-secret-key
# LANGFUSE_PUBLIC_KEY=your-langfuse-project-public-key
# LANGFUSE_BASE_URL=http://localhost:3001

# A2A Server Configuration
A2A_HOST=0.0.0.0
A2A_PORT=10001

# OpenAI-Compatible Wrapper (for Open WebUI integration)
OPENAI_COMPAT_HOST=0.0.0.0
OPENAI_COMPAT_PORT=11434

# Database (required for main_persistent.py / Docker deployment)
# Uncomment and configure for production use:
DATABASE_URL=postgresql://user:password@localhost:5432/{{ module_name }}

# MCP Server Configuration (example)
# EXAMPLE_API_KEY=your-api-key
