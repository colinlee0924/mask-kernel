"""A2A Server with SQLite persistence (Local Development).

This is the default entry point for local development with:
- SQLite checkpointer for conversation state persistence
- InMemoryTaskStore for A2A tasks
- Message synchronization support for Open WebUI retry/delete

For production with PostgreSQL, use main_persistent.py instead.

Usage:
    python -m {{ module_name }}.main
"""

import asyncio
import os
from pathlib import Path

import uvicorn
from dotenv import load_dotenv
from a2a.server.apps import A2AStarletteApplication
from a2a.server.request_handlers import DefaultRequestHandler
from a2a.server.tasks import InMemoryTaskStore
from a2a.types import AgentCapabilities, AgentCard, AgentSkill

from mask.a2a.helpers import create_a2a_executor
from mask.checkpoints import create_sqlite_checkpointer
from mask.observability import setup_openinference_tracing

from {{ module_name }}.agent import create_agent, streaming_middleware

# Load .env file from project root
env_path = Path(__file__).parent.parent.parent / ".env"
load_dotenv(env_path)


async def setup_agent():
    """Async setup for the agent with SQLite checkpointer."""
    # Use SQLite for local development (enables message sync)
    checkpointer = create_sqlite_checkpointer("checkpoints.db")
    return await create_agent(checkpointer=checkpointer), checkpointer


def main():
    """Start the A2A server (Local Development with SQLite)."""
    # Setup Phoenix tracing
    setup_openinference_tracing(
        project_name=os.environ.get("PHOENIX_PROJECT_NAME", "{{ project_name }}"),
        endpoint=os.environ.get("PHOENIX_COLLECTOR_ENDPOINT", "http://localhost:6006"),
        api_key=os.environ.get("PHOENIX_API_KEY"),
    )

    # Create agent with SQLite checkpointer
    agent, checkpointer = asyncio.run(setup_agent())

    # Create executor using MASK helper
    # stream=True enables real-time streaming for Open WebUI integration
    # checkpointer enables message sync (retry/delete detection)
    # streaming_middleware enables tool call and thinking status updates
    executor = create_a2a_executor(
        agent,
        server_name="{{ project_name }}",
        stream=True,
        checkpointer=checkpointer,
        streaming_middleware=streaming_middleware,
    )

    # Configure server
    host = os.environ.get("A2A_HOST", "0.0.0.0")
    port = int(os.environ.get("A2A_PORT", "10001"))

    # Create agent card for service discovery
    agent_card = AgentCard(
        name="{{ project_name }}",
        description="A MASK-powered agent with SQLite persistence",
        url=f"http://{host}:{port}/",
        version="1.0.0",
        skills=[
            AgentSkill(
                id="general",
                name="General Assistant",
                description="General purpose assistance",
                tags=["general"],
            ),
        ],
        capabilities=AgentCapabilities(streaming=True),
        defaultInputModes=["text"],
        defaultOutputModes=["text"],
    )

    # Create request handler (InMemory task store for local dev)
    handler = DefaultRequestHandler(
        agent_executor=executor,
        task_store=InMemoryTaskStore(),
    )

    # Create A2A application
    app = A2AStarletteApplication(
        agent_card=agent_card,
        http_handler=handler,
    )

    checkpointer_type = type(checkpointer).__name__ if checkpointer else "None"
    print(f"Starting {{ project_name }} on {host}:{port}...")
    print(f"Checkpointer: {checkpointer_type} (enables Open WebUI retry/delete sync)")
    print("Note: For production with PostgreSQL, use: python -m {{ module_name }}.main_persistent")
    uvicorn.run(app.build(), host=host, port=port, log_level="info")


if __name__ == "__main__":
    main()
