"""Agent configuration using LangChain create_agent + MASK SkillMiddleware.

Includes A2AStreamingMiddleware for real-time status updates in Open WebUI.
"""

from pathlib import Path
from typing import Optional

from langchain.agents import create_agent as langchain_create_agent
from langgraph.checkpoint.base import BaseCheckpointSaver
from langgraph.checkpoint.memory import MemorySaver

from mask.core import SkillRegistry
from mask.middleware import SkillMiddleware
from mask.middleware.a2a_streaming import A2AStreamingMiddleware
from mask.models import LLMFactory, ModelTier
from mask.mcp import load_mcp_tools_from_config

from {{ module_name }}.tools import get_custom_tools

# Create streaming middleware instance at module level
# This allows main.py to import and pass it to the executor
streaming_middleware = A2AStreamingMiddleware(agent_name="{{ project_name }}")


def load_system_prompt() -> str:
    """Load system prompt from prompts directory."""
    prompt_file = Path(__file__).parent / "prompts" / "system.md"
    if prompt_file.exists():
        return prompt_file.read_text(encoding="utf-8")
    return "You are a helpful assistant."


async def create_agent(
    tier: ModelTier = ModelTier.THINKING,
    checkpointer: Optional[BaseCheckpointSaver] = None,
):
    """Create agent using LangChain + MASK SkillMiddleware.

    This uses the native LangChain create_agent API with MASK's
    SkillMiddleware for Progressive Disclosure of skills.

    Args:
        tier: Model capability tier to use.
        checkpointer: Optional checkpoint saver for persistence.
            If None, uses MemorySaver (in-memory).
            For production, pass AsyncPostgresSaver from mask.checkpoints.

    Returns:
        LangChain agent with Progressive Disclosure support.
    """
    # Initialize LLM from tier
    model = LLMFactory().get_model(tier=tier)

    # Initialize skill registry and discover skills
    registry = SkillRegistry()
    skills_dir = Path(__file__).parent / "skills"
    if skills_dir.exists():
        registry.discover_from_directory(skills_dir)

    # Load MCP tools if config exists
    mcp_config = Path(__file__).parent / "config" / "mcp_servers.json"
    mcp_tools = []
    if mcp_config.exists():
        mcp_tools = await load_mcp_tools_from_config(mcp_config)

    # Combine all tools
    tools = [
        *registry.get_all_tools(),
        *get_custom_tools(),
        *mcp_tools,
    ]

    # Create SkillMiddleware for Progressive Disclosure
    # CRITICAL: Pass tools as additional_tools so they're always visible
    # (not filtered by skill state)
    middleware = SkillMiddleware(registry, additional_tools=tools)

    # Use provided checkpointer or default to MemorySaver
    if checkpointer is None:
        checkpointer = MemorySaver()

    # Create agent using native LangChain API
    # Returns CompiledStateGraph - pass directly to create_a2a_executor()
    # middleware includes:
    # - SkillMiddleware: Progressive Disclosure for skills
    # - A2AStreamingMiddleware: Real-time status updates (tool calls, thinking)
    return langchain_create_agent(
        model=model,
        tools=tools,
        system_prompt=load_system_prompt(),
        middleware=[middleware, streaming_middleware],
        checkpointer=checkpointer,
    )
